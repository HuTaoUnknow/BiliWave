    <file alias="icon.ico">icons/biliwave.ico</file>
    <file alias="check.svg">icons/check.svg</file>
    <file alias="up-dark.svg">icons/up-dark.svg</file>
    <file alias="down-dark.svg">icons/down-dark.svg</file>
    <file alias="up-pink.svg">icons/up-pink.svg</file>
    <file alias="down-pink.svg">icons/down-pink.svg</file>
  </qresource>
</RCC>
